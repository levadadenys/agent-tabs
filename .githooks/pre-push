#!/bin/sh
# Guard the default branch, and keep secrets and personal paths out of a repo
# that is intended to become public.
#
# GitHub branch protection needs a paid plan for private repositories, so this
# is the local stand-in. Enable it once per clone:
#
#     git config core.hooksPath .githooks
#
# Bypass deliberately (merging a PR locally, say) with:
#
#     git push --no-verify
#
PROTECTED="refs/heads/main"
# $1 is the remote name, $2 the destination URL. Prefer the URL: a remote
# with a separate pushurl would otherwise be queried at the wrong repo.
REMOTE_NAME="${1:-origin}"
REMOTE_TARGET="${2:-$REMOTE_NAME}"
ROOT=$(git rev-parse --show-toplevel)
CONFIG="$ROOT/.gitleaks.toml"
ZERO="0000000000000000000000000000000000000000"

fail() {
    echo "pre-push: $1" >&2
    shift
    for line in "$@"; do echo "          $line" >&2; done
    exit 1
}

# Scan the commits actually being pushed rather than the working tree: pushing
# another branch's ref from this checkout would otherwise go unexamined, and
# a leak that only exists in a commit would be missed entirely.
# Scan the tree a ref actually ships, not just the diffs that built it. Diff
# scanning has blind spots (merge handling, empty commits); the final tree is
# the ground truth for what lands on the remote.
scan_tree() {
    tmp=$(mktemp -d) || fail "could not create a temp dir to scan the pushed tree." \
                             "Refusing rather than skipping the scan."
    # Separate steps, not a pipeline: /bin/sh has no pipefail, so `git archive |
    # tar` reports tar's status and a failed archive would read as success.
    if ! git archive --format=tar -o "$tmp/tree.tar" "$1" 2>/dev/null; then
        rm -rf "$tmp"
        fail "could not archive $1 for scanning." \
             "Refusing rather than skipping the scan."
    fi
    if ! tar -x -f "$tmp/tree.tar" -C "$tmp" 2>/dev/null; then
        rm -rf "$tmp"
        fail "could not extract the tree for $1." \
             "Refusing rather than skipping the scan."
    fi
    rm -f "$tmp/tree.tar"
    if true; then
        if ! gitleaks dir "$tmp" --no-banner --redact --config "$CONFIG" \
                >/dev/null 2>&1; then
            echo "pre-push: gitleaks found secrets or personal paths in the tree" >&2
            echo "          being pushed:" >&2
            gitleaks dir "$tmp" --no-banner --redact --config "$CONFIG" 2>&1 \
                | grep -vE '^[[:space:]]*$' | tail -25 >&2
            rm -rf "$tmp"
            exit 1
        fi
    fi
    rm -rf "$tmp"
}


scan_range() {
    # Collapse whitespace: gitleaks splits --log-opts on spaces, so a doubled
    # one becomes an empty revision and git aborts with "ambiguous argument".
    set -- "$(printf '%s' "$1" | tr -s '[:space:]' ' ' | sed 's/^ //;s/ $//')"
    count=$(git rev-list --count $1 2>/dev/null) || \
        fail "could not resolve the commit range '$1'." \
             "Refusing rather than pushing unscanned. Override with --no-verify."
    [ "${count:-0}" -eq 0 ] && return 0

    if [ ! -f "$CONFIG" ]; then
        fail "$CONFIG is missing, so the custom rules would not apply." \
             "gitleaks would silently fall back to its default ruleset, which" \
             "does not look for home paths. Restore it, or --no-verify."
    fi

    if ! command -v gitleaks >/dev/null 2>&1; then
        fail "gitleaks is not installed, so the push cannot be scanned." \
             "Install it:  brew install gitleaks" \
             "Refusing rather than passing unscanned. Override with --no-verify."
    fi

    # -m diffs a merge commit against each parent. Without it gitleaks skips a
    # merge's own conflict resolution entirely, so a secret introduced while
    # resolving a conflict was reported clean. Verified.
    output=$(gitleaks git --no-banner --redact --config "$CONFIG" \
                 --log-opts="$1 -m" 2>&1)
    status=$?

    # gitleaks exits 0 when its own git invocation fails, so a bad range would
    # otherwise read as "clean". Treat scanning nothing we expected to scan as
    # a failure, not a pass.
    # Anchored so "10 commits scanned" is not read as "0 commits scanned".
    if echo "$output" | grep -qE '(^|[^0-9])0 commits scanned' ; then
        fail "gitleaks scanned no commits for range '$1' (expected $count)." \
             "$(echo "$output" | grep -i 'err' | head -3)" \
             "Refusing rather than trusting an empty scan."
    fi

    if [ "$status" -ne 0 ]; then
        echo "pre-push: gitleaks found secrets or personal paths in the commits" >&2
        echo "          being pushed:" >&2
        echo "$output" | grep -vE '^[[:space:]]*$' | tail -25 >&2
        echo "" >&2
        echo "          Use /Users/you in examples. Machine-specific values" >&2
        echo "          belong in ~/.agent-tabs/config.json, outside the repo." >&2
        exit 1
    fi
}

# What the remote actually holds right now, as ^sha exclusions. Local
# remote-tracking refs are not consulted: a branch deleted on the server still
# looks published locally, which previously let a new ref scan zero commits and
# ship a leak. Offline or on failure this yields nothing, so the scan widens to
# full history rather than silently narrowing.
remote_exclusions() {
    # Bounded: an unreachable remote would otherwise hang every push, and a
    # hook that hangs gets --no-verify'd into irrelevance. On timeout this
    # yields nothing, which widens the scan rather than narrowing it.
    # All advertised refs, not just heads: a commit kept reachable only by a tag
    # is already published, and excluding it avoids rescanning old history.
    ( git ls-remote "$REMOTE_TARGET" 2>/dev/null &
      lsr=$!
      ( sleep 10; kill "$lsr" 2>/dev/null ) 2>/dev/null &
      watcher=$!
      wait "$lsr" 2>/dev/null
      kill "$watcher" 2>/dev/null
    ) | awk '{print $1}' | \
    while read -r sha; do
        # Peel: an annotated tag's sha is a tag object, not a commit.
        commit=$(git rev-parse --quiet --verify "${sha}^{commit}" 2>/dev/null)
        if [ -n "$commit" ]; then
            printf '^%s\n' "$commit"
        fi
    done | tr '\n' ' ' | sed 's/[[:space:]]*$//'
}

# `|| [ -n "$remote_ref" ]` handles a final line with no trailing newline. Git
# always terminates it, but a guard that silently no-ops on malformed input
# fails the wrong way.
while read -r _local_ref local_sha remote_ref remote_sha || [ -n "$remote_ref" ]; do
    [ -z "$remote_ref" ] && continue

    if [ "$remote_ref" = "$PROTECTED" ]; then
        fail "refusing to push directly to ${PROTECTED#refs/heads/}." \
             "Open a PR:  git switch -c <type>/<topic> && gh pr create" \
             "See AGENTS.md. Override with --no-verify if you mean it."
    fi

    # A deletion pushes no content, so there is nothing to scan.
    [ "$local_sha" = "$ZERO" ] && continue

    scan_tree "$local_sha"

    if [ "$remote_sha" = "$ZERO" ]; then
        # A new ref: scan what the server does not already have. Local
        # remote-tracking refs go stale, so ask the remote what it actually
        # holds rather than trusting them. Falling back to full history would
        # otherwise reject every new branch over an old commit.
        excl=$(remote_exclusions)
        if [ -n "$excl" ]; then
            scan_range "$local_sha $excl"
        else
            scan_range "$local_sha"
        fi
    else
        scan_range "${remote_sha}..${local_sha}"
    fi
done

exit 0
