#!/usr/bin/env python3
"""agent-tabs -- snapshot and restore iTerm tabs full of agent sessions."""

from __future__ import annotations

import argparse
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from agent_tabs import adapters, iterm, restore as restore_mod, snapshot as snap_mod  # noqa: E402

def age_of(captured_at: str) -> str:
    """How long ago a snapshot was taken, in words.

    A raw ISO timestamp makes the reader do arithmetic at the worst possible
    moment; a recorder that died days ago should be obvious at a glance.
    """
    try:
        when = datetime.fromisoformat(captured_at)
    except ValueError:
        return "age unknown"
    if when.tzinfo is None:
        when = when.replace(tzinfo=timezone.utc)
    seconds = int((datetime.now(timezone.utc) - when).total_seconds())
    if seconds < 0:
        return "in the future"
    if seconds < 90:
        return f"{seconds}s ago"
    minutes = seconds // 60
    if minutes < 90:
        return f"{minutes}m ago"
    hours = minutes // 60
    if hours < 48:
        return f"{hours}h {minutes % 60}m ago"
    return f"{hours // 24}d {hours % 24}h ago"


KIND_MARK = {"claude": "C", "codex": "X", "grok": "G", "ssh": "S",
             "shell": ".", "command": ">", "empty": " "}


def cmd_snapshot(args) -> int:
    if not iterm.is_running():
        print("iTerm2 is not running; nothing to capture.", file=sys.stderr)
        return 1
    snap = snap_mod.build()
    latest, archive = snap_mod.save(snap)
    agents = snap_mod.agent_tab_count(snap)
    # Rows are per-pane; a split tab contributes several. Count real tabs.
    tabs = sum(len({t["tab_index"] for t in w["tabs"]}) for w in snap["windows"])
    where = latest or archive
    if args.quiet:
        return 0
    print(f"{len(snap['windows'])} windows, {tabs} tabs, {agents} agent sessions -> {where}")
    if latest is None:
        print("No agent sessions found; kept the previous snapshot.json.")
    return 0


def _print_window(window: dict, tabs: list[dict]) -> None:
    print(f"\nWindow {window['window_index']}  ({len({t['tab_index'] for t in tabs})} tabs)")
    for tab in tabs:
        mark = KIND_MARK.get(tab.get("kind"), "?")
        title = (tab.get("title") or "").strip() or "(untitled)"
        # Only the first pane of a tab is ever recreated; label the rest so the
        # listing cannot be mistaken for a set of separately restorable tabs.
        pane = "" if tab.get("pane_index", 1) == 1 else f" (pane {tab['pane_index']}, not restored)"
        print(f"  [{mark}] tab {tab['tab_index']:>2}  {title[:64]}{pane}")
        if tab.get("restore"):
            print(f"          {tab['restore']}")
        if tab.get("warning"):
            print(f"          !! {tab['warning']}")


def cmd_list(args) -> int:
    snap = snap_mod.load(Path(args.file) if args.file else None)
    _warn_if_replaced(snap)
    wanted = set(args.kind or [])

    def keep(tab: dict) -> bool:
        # Filter on the resolved kind, never on the tab title -- a title is
        # whatever the agent last wrote to the terminal and may say anything.
        return not wanted or tab.get("kind") in wanted

    if args.commands:
        for window in snap["windows"]:
            seen = set()
            for tab in window["tabs"]:
                # Mirror restore: one command per tab, the first pane.
                if tab["tab_index"] in seen:
                    continue
                seen.add(tab["tab_index"])
                if keep(tab) and tab.get("restore"):
                    print(tab["restore"])
        return 0

    print(
        f"Snapshot captured {snap['captured_at']}  ({age_of(snap['captured_at'])})"
        f"  -  {snap_mod.agent_tab_count(snap)} agent sessions"
    )
    shown = 0
    for window in snap["windows"]:
        tabs = [t for t in window["tabs"] if keep(t)]
        if not tabs:
            continue
        shown += len(tabs)
        _print_window(window, tabs)
    if wanted and not shown:
        print(f"\nNo tabs of kind: {', '.join(sorted(wanted))}")
        return 0
    print(
        "\nRestore everything:  agent-tabs restore --all            (dry run; add --go)"
        "\n  windows iTerm did not bring back:  add --create-missing"
    )
    return 0


def _warn_if_replaced(snap: dict) -> None:
    """Flag a post-reboot snapshot that lost sessions. On stderr, so piped
    output such as `list --commands` stays clean."""
    warning = snap_mod.pre_boot_warning(snap)
    if warning:
        print("\n!! " + warning.replace("\n", "\n   ") + "\n", file=sys.stderr)


def _print_plan(window, actions, warnings) -> None:
    for action in actions:
        if action.will_run:
            print(f"  tab {action.tab_index:>2}  {action.command}")
        else:
            print(f"  tab {action.tab_index:>2}  SKIP ({action.skip_reason})")
        if action.tab_index in warnings:
            print(f"          !! {warnings[action.tab_index]}")


def _warnings_for(window: dict) -> dict:
    return {
        t["tab_index"]: t["warning"]
        for t in window.get("tabs", []) if t.get("warning")
    }


def cmd_restore_all(args, snap, live) -> int:
    """Restore every live window that matches a snapshot window, in one pass.

    With --create-missing, a snapshot window nothing matched is rebuilt in a
    new window instead of only being reported -- the path for a reboot where
    iTerm did not bring the windows back.
    """
    pairs, unmatched, notes = restore_mod.match_all(snap, live)
    running = restore_mod.running_sessions()

    print(f"Snapshot captured {snap['captured_at']}  ({age_of(snap['captured_at'])})")
    create = unmatched if args.create_missing else []

    if not pairs and not create:
        print("\nNo live window matched a snapshot window.", file=sys.stderr)
        for note in notes:
            print(f"  {note}", file=sys.stderr)
        for window in unmatched:
            tabs = len({t["tab_index"] for t in window["tabs"]})
            print(
                f"  snapshot window {window['window_index']} ({tabs} tabs): "
                f"agent-tabs restore {window['window_index']} --new-window --go",
                file=sys.stderr,
            )
        print(
            "\nTo rebuild all of them in new windows at once:"
            "\n  agent-tabs restore --all --create-missing --go",
            file=sys.stderr,
        )
        return 2

    planned = []
    total = 0
    for live_index, window in pairs:
        window_id = restore_mod.window_id_for_index(live, live_index)
        actions = restore_mod.plan(window, live, window_id, args.force, running)
        runnable = [a for a in actions if a.will_run]
        total += len(runnable)
        planned.append((f"live window {live_index}", window_id, actions))
        print(
            f"\nsnapshot window {window['window_index']} -> live window "
            f"{live_index}  ({len(runnable)} to start)"
        )
        _print_plan(window, actions, _warnings_for(window))

    for window in create:
        # target None: a window that does not exist yet has no busy tabs and
        # cannot contain the tab this command runs from.
        actions = restore_mod.plan(window, live, None, args.force, running)
        runnable = [a for a in actions if a.will_run]
        total += len(runnable)
        planned.append(("a new window", None, actions))
        print(
            f"\nsnapshot window {window['window_index']} -> a new window  "
            f"({len(runnable)} to start)"
        )
        _print_plan(window, actions, _warnings_for(window))

    reported = [w for w in unmatched if w not in create]
    if reported or notes:
        print("\nNot restored:")
        for note in notes:
            print(f"  {note}")
        for window in reported:
            tabs = len({t["tab_index"] for t in window["tabs"]})
            print(
                f"  snapshot window {window['window_index']} ({tabs} tabs): no live "
                f"window matched — rebuild it with:  agent-tabs restore "
                f"{window['window_index']} --new-window --go"
            )
        if reported and not args.create_missing:
            print("  (or add --create-missing to rebuild every unmatched window)")

    if not args.go:
        print(f"\nDry run. {total} tabs would start across {len(planned)} windows.")
        print("Add --go to execute.")
        return 0
    if total == 0:
        print("\nNothing to do.")
        return 0

    started = 0
    for label, window_id, actions in planned:
        if label == "a new window":
            started += restore_mod.restore_into_new_window(actions, args.force)
        elif window_id is None:
            print(f"\n{label} vanished before it could be restored.")
        else:
            started += restore_mod.execute(actions, window_id, args.force)
    print(f"\nStarted {started} tabs across {len(planned)} windows.")
    return 0


def cmd_restore(args) -> int:
    snap = snap_mod.load(Path(args.file) if args.file else None)
    _warn_if_replaced(snap)
    live = restore_mod.live_tabs()

    if args.create_missing and not args.all:
        print("--create-missing only applies to --all.", file=sys.stderr)
        return 2

    if args.all:
        if args.window is not None or args.new_window:
            print(
                "--all restores every matching window, so it cannot be combined "
                "with a window number or --new-window.",
                file=sys.stderr,
            )
            return 2
        return cmd_restore_all(args, snap, live)

    try:
        window, how = restore_mod.select_window(snap, args.window, live)
    except ValueError as exc:  # includes restore_mod.Ambiguous
        print(str(exc), file=sys.stderr)
        return 2

    if args.new_window:
        target = None
        target_label = "a new window"
    else:
        target = restore_mod.current_window_id(live)
        if target is None:
            print(
                "Not running inside an iTerm tab, so there is no current window to fill.\n"
                "Re-run from an iTerm tab, or pass --new-window.",
                file=sys.stderr,
            )
            return 2
        target_label = f"live window {restore_mod.current_window_index(live)}"

    actions = restore_mod.plan(
        window, live, target, args.force, restore_mod.running_sessions()
    )
    runnable = [a for a in actions if a.will_run]

    # Staleness matters most in exactly the situation this command is used in:
    # a recorder that died hours ago looks identical to a healthy one.
    print(f"Snapshot captured {snap['captured_at']}  ({age_of(snap['captured_at'])})")
    print(f"Restoring {how} into {target_label}\n")
    _print_plan(window, actions, _warnings_for(window))

    if not args.go:
        print(f"\nDry run. {len(runnable)} tabs would start. Add --go to execute.")
        return 0
    if not runnable:
        print("\nNothing to do.")
        return 0

    if target is None:
        target = iterm.create_window(max(a.tab_index for a in runnable))
    ran = restore_mod.execute(actions, target, args.force)
    print(f"\nStarted {ran} tabs.")
    return 0


def cmd_install(args) -> int:
    from agent_tabs import install

    return install.run(force=args.force)


def main() -> int:
    parser = argparse.ArgumentParser(prog="agent-tabs", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p_snap = sub.add_parser("snapshot", help="capture the current window/tab map")
    p_snap.add_argument("-q", "--quiet", action="store_true")
    p_snap.set_defaults(func=cmd_snapshot)

    p_list = sub.add_parser("list", help="show what the last snapshot holds")
    p_list.add_argument("-f", "--file", help="read a specific snapshot file")
    p_list.add_argument(
        "-k", "--kind", action="append",
        choices=list(adapters.ALL_KINDS),
        help="only show tabs of this kind (repeatable)",
    )
    p_list.add_argument(
        "--commands", action="store_true",
        help="print bare restore commands, one per line",
    )
    p_list.set_defaults(func=cmd_list)

    p_restore = sub.add_parser("restore", help="replay a snapshot window into tabs")
    p_restore.add_argument("window", nargs="?", type=int, help="snapshot window number")
    p_restore.add_argument("-f", "--file", help="read a specific snapshot file")
    p_restore.add_argument("--go", action="store_true", help="actually run (default is a dry run)")
    p_restore.add_argument("--new-window", action="store_true", help="build a fresh window")
    p_restore.add_argument(
        "--all", action="store_true",
        help="restore every live window that matches a snapshot window",
    )
    p_restore.add_argument(
        "--create-missing", action="store_true",
        help="with --all: rebuild snapshot windows nothing matched in new windows",
    )
    p_restore.add_argument("--force", action="store_true", help="overwrite tabs already running an agent")
    p_restore.set_defaults(func=cmd_restore)

    p_install = sub.add_parser("install", help="install the recorder and CLI")
    p_install.add_argument("--force", action="store_true", help="overwrite an existing install")
    p_install.set_defaults(func=cmd_install)

    args = parser.parse_args()
    try:
        return args.func(args)
    except FileNotFoundError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    except iterm.ITermError as exc:
        print(f"iTerm error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
